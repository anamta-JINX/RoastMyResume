# Server
PORT=5000
NODE_ENV=development

# Frontend URL
CLIENT_URL=http://localhost:5173

# Groq API
# Get your API key from Groq Console and paste it in your real .env file
GROQ_API_KEY=your_groq_api_key_here

# Groq model
GROQ_MODEL=llama-3.3-70b-versatile

# Upload settings
MAX_FILE_SIZE_MB=5

# Premium feature flag
# false = download disabled unless premium is unlocked
# true = useful for local testing
DEV_UNLOCK_PREMIUM=false

# LinkedIn share
LINKEDIN_SHARE_URL=https://www.linkedin.com/sharing/share-offsite/